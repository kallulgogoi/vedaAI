{
  "compilerOptions": {
    "target": "ES2022",                                  
    "module": "CommonJS",                                
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "rootDir": "./src",                                  
    "outDir": "./dist",                                  
    "strict": true,                                      
    "esModuleInterop": true,                             
    "skipLibCheck": true,                                
    "forceConsistentCasingInFileNames": true             
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}